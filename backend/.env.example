APP_ENV=development
APP_NAME=IoTSense API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://iotsense:iotsense@localhost:5432/iotsense
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=iotsense_session
CSRF_COOKIE_NAME=iotsense_csrf
SECURE_COOKIES=false
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=900
TELEMETRY_MAX_PAST_AGE_SECONDS=86400
TELEMETRY_MAX_PAYLOAD_BYTES=65536
# Configure SMTP before enabling password reset in a deployed environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
CORS_ORIGINS=["http://localhost:5173"]
